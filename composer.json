{
    "name": "bladewright/builder",
    "description": "Build and edit a Laravel site from the browser — pages, layouts, components and blocks, seen as you make them.",
    "keywords": ["laravel", "cms", "blade", "livewire"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/commonmark": "^2.7",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Bladewright\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bladewright\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "serve": [
            "@prepare",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bladewright\\BladewrightServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
